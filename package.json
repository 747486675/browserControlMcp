{
  "name": "browser-mcp",
  "version": "0.2.0",
  "description": "让 AI 通过 MCP 操作真实 Chrome：独立 profile（CDP）或你日常的 Chrome（插件模式），带危险动作确认",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chrome",
    "browser",
    "automation",
    "playwright",
    "claude",
    "codex"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "browser-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "extension",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "smoke": "npm run build && tsx test/smoke.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/<your-name>/browser-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "playwright-core": "1.63.0",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
